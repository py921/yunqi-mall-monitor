# 云启商城（YunQi Mall）微服务监控平台 —— 环境变量模板
# 使用方式：cp .env.example .env，然后按需修改

# ---------------------------------------------------------------- 基础
APP_ENV=dev
APP_VERSION=1.0.0

# ---------------------------------------------------------------- 对外端口
GATEWAY_PORT=80
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# ---------------------------------------------------------------- MySQL
MYSQL_ROOT_PASSWORD=Root@2024
MYSQL_DATABASE=yunqi_mall
MYSQL_USER=mall
MYSQL_PASSWORD=Mall@2024
MYSQL_EXPORTER_PASSWORD=Exporter@2024

# ---------------------------------------------------------------- Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ------------------------------------------------- 业务故障模拟（演示用）
# 调大这些值可以让告警真实触发，方便演示告警链路
ORDER_FAIL_RATE=0.06
PAY_CALLBACK_FAIL_RATE=0.035
LOGIN_FAIL_RATE=0.03

# ---------------------------------------------------------------- 流量生成
GENERATOR_TPS=6
GENERATOR_USER_POOL=200

# ---------------------------------------------------------------- 告警通知
# 留空则只写入 alert-webhook 日志；
# 填上钉钉自定义机器人的 Webhook 地址后，P0/P1/P2 告警会自动推送到群里
DINGTALK_WEBHOOK=
